        <mxCell id="titulo" value="SIGEVA — modelo relacional en 3FN (to-be multi-tenant)&#xa;Cada atributo depende de su dueño directo. La organización se alcanza por la sede, no se copia en cada tabla electoral." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="900" height="52" as="geometry" />
        </mxCell>
        <mxCell id="leyenda" value="1FN: campos atómicos.  2FN: nada depende de parte de una llave.  3FN: no se guarda lo que ya se obtiene por FK (ej. idorganizacion en elección).&#xa;UQ = único.  PK = llave.  FK = dueño directo.  Línea punteada = opcional (ficha SENA)." style="text;html=1;strokeColor=#CCCCCC;fillColor=#FAFAFA;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="72" width="900" height="48" as="geometry" />
        </mxCell>

